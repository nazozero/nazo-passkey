","version":"0.11.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"smallvec","version":"1.16.3","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"tokio","version":"1.54.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"tokio-util","version":"0.7.20","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"tracing","version":"0.1.44","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"zstd","version":"0.14.3","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null}}]},"warnings":{"unmaintained":[{"kind":"unmaintained","package":{"name":"chrono","version":"0.4.45","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"1aa79e62e7697b8e29b513a68abacf485adcd1fe8284a4316c5ae868e6633327","dependencies":[{"name":"iana-time-zone","version":"0.1.65","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"js-sys","version":"0.3.107","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"num-traits","version":"0.2.19","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"serde","version":"1.0.229","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"wasm-bindgen","version":"0.2.130","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"windows-link","version":"0.2.1","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0543","package":"chrono","title":"chrono is unmaintained","description":"The chrono crate is unmaintained; all versions are affected.\n\nRecommended alternatives:\n\n- [jiff](https://crates.io/crates/jiff)\n- [time](https://crates.io/crates/time)","date":"2026-09-14","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":[],"cvss":null,"informational":"unmaintained","references":[],"source":null,"url":"https://gith