.*
!.gitignore
!.github
target/
# Lockfiles are retained for reproducible security checks and benchmarks.
fuzz/artifacts/
fuzz/coverage/
fuzz/target/
perf/target/
interop/node_modules/

.DS_Store

# Local SQLite databases left behind by the axum_sqlite example.
passkeys.db
passkeys.db-journal
passkeys.db-wal
passkeys.db-shm
fuzz/corpus/ceremonies/*
!fuzz/corpus/ceremonies/none-*
!fuzz/corpus/ceremonies/packed-*
!fuzz/corpus/ceremonies/fido-*
!fuzz/corpus/ceremonies/nested
!fuzz/corpus/ceremonies/overflow
!fuzz/corpus/ceremonies/regression-*

!/.gitattributes
!/.mailmap
__pycache__/
